# Leporidae API
NUXT_LEPORIDAE_BASE_URL="https://api.turou.fun/leporidae"
NUXT_LEPORIDAE_FE_PUBLIC_URL="https://hoshirabi.com"

# Application settings
NUXT_USAGIPASS_DATABASE_URL="postgresql://postgres:password@localhost:5432/usagipass"
NUXT_PUBLIC_URL="http://127.0.0.1:7200"

# MITM Proxy settings
NUXT_MITMPROXY_ENABLED=true
NUXT_MITMPROXY_LISTEN_HOST=127.0.0.1
NUXT_MITMPROXY_LISTEN_PORT=7300

# OAuth client from the leporidae developer center; the callback must be registered on the app
# (derived automatically from NUXT_PUBLIC_URL: <base>/api/nuxt/auth/leporidae)
NUXT_OAUTH_OIDC_CLIENT_ID=
NUXT_OAUTH_OIDC_CLIENT_SECRET=